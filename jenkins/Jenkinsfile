pipeline {
    agent any

    environment {
        CI = 'true'
        NODE_OPTIONS = '--openssl-legacy-provider'
    }

    stages {

        stage('Build') {
            steps {
                echo "===== BUILD STAGE ====="
                sh 'rm -rf app || true'
                sh 'git clone -b react-app https://github.com/alysha10/a428-cicd-labs.git app'
                dir('app') {
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }

        stage('Test') {
            steps {
                echo "===== TEST STAGE ====="
                dir('app') {
                    sh 'chmod +x jenkins/scripts/*.sh'
                    sh './jenkins/scripts/test.sh || true'
                }
            }
        }

        stage('Manual Approval') {
            steps {
                echo "===== MANUAL APPROVAL STAGE ====="
                input message: 'Apakah ingin melanjutkan ke Deploy?', ok: 'Ya, Deploy!'
            }
        }

        stage('Deploy') {
            steps {
                echo "===== DEPLOY STAGE ====="
                sh '''
                rm -rf /var/www/html/* || true
                cp -r app/build/* /var/www/html/
                echo "Deploy selesai."
                '''
            }
        }

        // ✅ TAMBAHAN STAGE SESUAI KRITERIA KE-3
        stage('Run App for 1 Minute') {
            steps {
                echo "===== RUN APPLICATION FOR 1 MINUTE ====="
                dir('app') {
                    sh '''
                    echo "Menjalankan aplikasi selama 1 menit..."
                    
                    # Install serve jika belum ada
                    npm install -g serve

                    # Jalankan aplikasi di background
                    serve -s build -l 3000 &
                    APP_PID=$!

                    # Tunggu 60 detik
                    sleep 60

                    echo "Menghentikan aplikasi..."
                    kill $APP_PID

                    echo "Aplikasi dihentikan setelah 1 menit."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'PIPELINE SUCCESS'
        }
        failure {
            echo 'PIPELINE FAILED'
        }
    }
}
